class NumArray {
    int[] arr;
    public NumArray(int[] nums) {
        int sum=0;
        int n=nums.length;
        arr=new int[n];
        for(int i=0;i<n;i++){
            sum=sum+nums[i];
            arr[i]=sum;
        }
    }
    public int sumRange(int left, int right) {
        int sum1=0;
        if(left>0){
            sum1=arr[right]-arr[left-1];
        }
        else if(left==0){
            sum1=arr[right];
        }
        return sum1;
    }
}
