//Brute Force Approach
class Solution {
    public int[] productExceptSelf(int[] nums) {
        int pr=1;
        int pr1=1;
        int n=nums.length;
        int[] arr= new int[n];
        for(int i=0;i<n;i++){
            pr=1;
            pr1=1;
        for(int k=i-1;k>=0;k--){
            pr=pr*(nums[k]);
        }
        for(int j=i+1;j<n;j++){
            pr1=pr1*(nums[j]);
        }
        int p=pr1*pr;
        arr[i]=p;
        }
        return arr;
    }
}
//Optimal Solution
class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n = nums.length;
        int[] answer = new int[n];
        answer[0] = 1;
        for (int k = 1; k < n; k++) {
            answer[k] = answer[k - 1] * nums[k - 1];
        }
        int pr = 1;
        for (int j = n - 1; j >= 0; j--) {
            answer[j] = answer[j] * pr;
            pr = pr * nums[j];
        }
        return answer;
    }
}
